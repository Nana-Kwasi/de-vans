# Production build config for the admin dashboard.
# Vite inlines VITE_* at BUILD time, so changing this needs a rebuild, not a restart.
# Not a secret: the API base URL ships inside the JS bundle either way.
VITE_API_BASE_URL=https://quickchop-backend-g4kiqgy27q-nw.a.run.app

# Live Orders updates: "poll" needs no extra services.
VITE_ORDERS_REFRESH_MODE=poll
VITE_ORDERS_POLL_MS=5000
