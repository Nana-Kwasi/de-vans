# ---- QuickChop Admin Web environment ----
# Copy to .env. Vite exposes only VITE_* vars to the browser.

# Spring Boot API base URL
VITE_API_BASE_URL=http://localhost:8080

# How the Live Orders page gets updates: "poll" (simple, default) or "realtime".
# Poll is chosen by default — it needs no extra services and is easy to reason
# about; the tradeoff is a small fixed delay + steady request volume. Supabase
# Realtime would push instantly but couples the dashboard to Supabase directly,
# which the architecture otherwise avoids.
VITE_ORDERS_REFRESH_MODE=poll
VITE_ORDERS_POLL_MS=5000
