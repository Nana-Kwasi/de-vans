# ---- QuickChop Mobile (Expo) environment ----
# Copy to .env. Expo reads EXPO_PUBLIC_* vars at build/start time (app.config.js).

# Spring Boot API. Leave this UNSET for normal development: the app then derives the
# host from the Metro connection, so it follows your laptop's LAN IP on its own and a
# phone on the same Wi-Fi reaches your local backend without edits.
#
# Setting it pins the app to that backend, overriding the Metro host — which is how you
# point a dev build at the deployed API:
# EXPO_PUBLIC_API_BASE_URL=https://quickchop-backend-g4kiqgy27q-nw.a.run.app

# Supabase project (Auth only — email/password + Google). From Supabase ->
# Project Settings -> API. Anon key may be shown as "publishable" (sb_publishable_...).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Google Maps SDK for Android key (Google Cloud → Maps SDK for Android). Needed for the
# delivery-pin and rider-tracking maps on Android builds; iOS uses Apple Maps (no key).
GOOGLE_MAPS_ANDROID_API_KEY=
