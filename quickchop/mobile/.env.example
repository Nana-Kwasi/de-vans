# ---- QuickChop Mobile (Expo) environment ----
# Copy to .env. Expo reads EXPO_PUBLIC_* vars at build/start time (app.config.js).

# Spring Boot API. On a physical device, use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Supabase project (Auth only — email/password + Google). From Supabase ->
# Project Settings -> API. Anon key may be shown as "publishable" (sb_publishable_...).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
