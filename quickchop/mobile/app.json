{
  "expo": {
    "name": "Qooka Qooks Restaurant",
    "slug": "quickchop",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "quickchop",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF7A18"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quickchop.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Qooka Qooks Restaurant uses your location to show your delivery area and to guide your rider to your exact door."
      }
    },
    "android": {
      "package": "com.quickchop.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF7A18"
      }
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
