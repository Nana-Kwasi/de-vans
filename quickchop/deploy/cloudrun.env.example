# Environment for the Cloud Run service. Copy to deploy/cloudrun.env, fill in, and it is
# read by deploy/deploy-cloudrun.sh. Git-ignored — it holds live secrets.
#
# Most of these already exist in backend/.env; the deploy-only keys are the GCP_ block
# and SERVICE_NAME. The script refuses to deploy while any <placeholder> remains.

# --- Deployment target (read by the script, never sent to the container) -----
GCP_PROJECT=project-e45edf99-8cdd-4e55-a7d
# London: closest to Supabase (eu-west-1, Ireland).
GCP_REGION=europe-west2
SERVICE_NAME=quickchop-backend

# --- Database: Supabase -----------------------------------------------------
# Use the SESSION pooler (port 5432 on the pooler host), not the direct connection.
# The direct host (db.<ref>.supabase.co) resolves to IPv6 only and Cloud Run egresses
# over IPv4, so it times out with nothing useful in the logs.
# The username is postgres.<project-ref>, not postgres.
# Keep the quotes: the '&' in the query string must survive `source`.
SUPABASE_DB_URL="jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require&prepareThreshold=0"
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<supabase-database-password>

# Small pool per instance: 5 x max-instances 4 = 20 connections at peak.
DB_POOL_SIZE=5
DB_MIN_IDLE=1

# --- Supabase Auth (validates customer JWTs) --------------------------------
# API domain (project-ref.supabase.co), NOT the pooler host.
SUPABASE_JWKS_URI=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER_URI=https://<project-ref>.supabase.co/auth/v1

# --- Supabase Storage (meal images) -----------------------------------------
# Uploads are streamed straight to Supabase Storage, never written to disk, so Cloud
# Run's ephemeral filesystem is not a problem.
SUPABASE_URL=https://<project-ref>.supabase.co
# service_role secret — server-only, bypasses Storage RLS. Never ship to clients.
SUPABASE_SERVICE_KEY=<service-role-key>
SUPABASE_BUCKET=menu-images

# --- Security ---------------------------------------------------------------
# Admin session JWT, Spring-issued. Must be >= 32 bytes. Generate a fresh one:
#   openssl rand -base64 48
ADMIN_JWT_SECRET=<openssl rand -base64 48>
ADMIN_JWT_EXPIRY_MINUTES=720

# Browser origins allowed to call the API, comma separated. Blank means any origin.
# The mobile app is unaffected either way (native clients send no Origin header).
# Set this once the admin dashboard is hosted.
CORS_ALLOWED_ORIGINS=

# --- Payments: Paystack -----------------------------------------------------
PAYSTACK_SECRET_KEY=<paystack-secret-key>
PAYSTACK_BASE_URL=https://api.paystack.co

# --- Push notifications -----------------------------------------------------
# A filesystem path to a service-account JSON. There is no such file in the container,
# so leave it blank: NotificationService then logs pushes instead of sending them, and
# nothing else changes. Mounting the JSON from Secret Manager is the way to enable it.
FCM_CREDENTIALS_PATH=

# --- App config -------------------------------------------------------------
BUSINESS_NAME=QuickChop
DELIVERY_FEE=10.00
