# ---- QuickChop Backend environment variables ----
# Copy to .env and fill in real values. Never commit .env.

# ---- Supabase Postgres via the CONNECTION POOLER (recommended) ----
# In Supabase: click "Connect" (top bar) -> "Session pooler" tab. Use those values.
#
# Two things people always get wrong with the pooler:
#   1. The host is the POOLER host, NOT db.<ref>.supabase.co. It looks like:
#        aws-0-<region>.pooler.supabase.com   (e.g. aws-0-eu-west-1.pooler.supabase.com)
#   2. The username is "postgres.<project-ref>", NOT just "postgres".
#        e.g. postgres.abcdefghijklmno
#
# Use port 5432 = SESSION pooler (best for this app: supports Flyway migrations
# and works over IPv4). Port 6543 = transaction pooler; prepareThreshold=0 below
# keeps that mode working too, but stick with 5432 unless you have a reason.
#
# The ?sslmode=require&prepareThreshold=0 query string is required — keep it.
# NOTE: keep the quotes — the '&' must be quoted so the shell doesn't choke on it.
SUPABASE_DB_URL="jdbc:postgresql://aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres?sslmode=require&prepareThreshold=0"
SUPABASE_DB_USER=postgres.YOUR-PROJECT-REF
SUPABASE_DB_PASSWORD=your-db-password

# Optional pool tuning (defaults are fine for a small business):
# DB_POOL_SIZE=8
# DB_MIN_IDLE=1

# ---- Supabase Auth (validates customer phone-OTP JWTs) ----
# Replace <project-ref> with your project ref — the SAME ref as in SUPABASE_DB_USER
# above (Supabase -> Project Settings -> General -> "Reference ID", e.g. abcdefghijklmno).
# This is the API domain (project-ref.supabase.co), NOT the pooler host used for the DB.
# Quick check: opening SUPABASE_JWKS_URI in a browser should return JSON with a "keys" array.
SUPABASE_JWKS_URI=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ISSUER_URI=https://YOUR-PROJECT-REF.supabase.co/auth/v1

# ---- Supabase Storage (meal images live in a public bucket) ----
# API domain, same project-ref as above (NOT the pooler host).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role secret: Supabase -> Project Settings -> API -> "service_role".
# Server-only — bypasses Storage RLS. NEVER ship this to the mobile/web clients.
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_BUCKET=menu-images

# Admin session JWT (Spring-issued) — MUST be a random string >= 32 bytes.
# Distinct from Supabase's secret. Generate: openssl rand -base64 48
ADMIN_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
ADMIN_JWT_EXPIRY_MINUTES=720

# Paystack (test keys during development)
PAYSTACK_SECRET_KEY=<your-paystack-test-secret-key>
PAYSTACK_BASE_URL=https://api.paystack.co

# Firebase Cloud Messaging service-account JSON path (leave blank to disable push)
FCM_CREDENTIALS_PATH=

# App config
BUSINESS_NAME=QuickChop
DELIVERY_FEE=10.00
PORT=8080

# ---- Email (Gmail SMTP) ----
# Leave MAIL_HOST blank to disable sending entirely: support alerts, order-status
# emails and admin password-reset links are logged instead, and nothing fails.
# Gmail requires an APP PASSWORD (Google account -> 2-Step Verification -> App
# passwords), never the account password.
# MAIL_FROM must equal MAIL_USERNAME — Gmail rewrites a From address it does not own.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your-account@gmail.com
# Inbox that receives new support tickets.
SUPPORT_INBOX=your-account@gmail.com
# Admin dashboard base URL, used to build password-reset links.
ADMIN_APP_URL=http://localhost:5173
PASSWORD_RESET_EXPIRY_MINUTES=60

# ---- Riders ----
# Optional: dedicated signing key for rider sessions (>= 32 bytes). Blank derives one
# from ADMIN_JWT_SECRET.
RIDER_JWT_SECRET=
RIDER_JWT_EXPIRY_MINUTES=720
RIDER_MAX_ACTIVE_DELIVERIES=1
RIDER_REQUIRE_PIN=true

# ---- Security ----
# Proxies in front of the API that append to X-Forwarded-For (1 = Cloud Run, 0 = none).
RATE_LIMIT_PROXY_HOPS=1
RATE_LIMIT_PER_MINUTE=300
# Turn off Swagger UI / OpenAPI docs in production.
SWAGGER_ENABLED=true
